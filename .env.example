# ---- fin-fy database backend ------------------------------------------------
# sqlite | libsql (Turso Cloud / self-hosted sqld) | postgres
DB_TYPE=libsql

# --- for DB_TYPE=libsql (Turso Cloud or self-hosted sqld) ---
# Turso Cloud:  turso db create finfy  ->  libsql://finfy-<org>.turso.io
#               turso db tokens create finfy  ->  the auth token
# Self-hosted sqld: ws://<host>:5001 (and no token unless you configured JWT)
TURSO_URL=libsql://finfy-<org>.turso.io
TURSO_AUTH_TOKEN=

# --- for DB_TYPE=sqlite (single file, no server) ---
# DB_TYPE=sqlite
DB_PATH=data/fin_fy.db

# --- for DB_TYPE=postgres ---
DB_USER=user
DB_PASS=password
DB_PORT=5544
DB_NAME=fin_fy
